SCENE_THRESHOLD=22.0
MAX_CLIPS_PER_JOB=1500
# ---- Encoding / concurrency (new — controls parallel jobs) ----
# How many jobs process at the same time. Each one runs its own ffmpeg
# encode, which is RAM-hungry — raise this only as far as your server's
# RAM actually supports (watch `free -m` while a couple of jobs run).
MAX_CONCURRENT_JOBS=2
# Lower preset / fewer threads per encode = less RAM per job. If you raise
# MAX_CONCURRENT_JOBS and start seeing "-9" (OOM) errors again, lower these.
FFMPEG_PRESET=veryfast
FFMPEG_THREADS=2
# ---- Credits ----
STARTING_CREDITS=3
CREDITS_PER_JOB=1
# ---- Misc ----
LOG_LEVEL=INFO
LOG_FILE=bot.log
DB_PATH=bot_data.db
