# ── Telegram ────────────────────────────────────────────────────────────
BOT_TOKEN=8489971288:AAH--M3E65xz0l9Ju7dAvorc4cf5iJ99x7U

# ── Owners ──────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs. These users bypass credit checks
# entirely (unlimited credits) and can run /addcredits.
OWNER_ID=8260250479,7973976213

# ── Storage paths ───────────────────────────────────────────────────────
TEMP_FOLDER=temp
OUTPUT_FOLDER=clips
DB_PATH=bot_data.db

# ── Video / clip limits ─────────────────────────────────────────────────
# NOTE: Telegram's cloud Bot API caps downloads at 20MB and uploads at
# 50MB regardless of this setting. To truly support up to 2048MB you need
# to run a local Bot API server (see: https://github.com/tdlib/telegram-bot-api)
# and point python-telegram-bot at it.
MAX_VIDEO_SIZE_MB=2048
DEFAULT_CLIP_LENGTH=15
SCENE_THRESHOLD=22.0
MAX_CLIPS_PER_JOB=100

# ── Credits ─────────────────────────────────────────────────────────────
# Credits a brand-new (non-owner) user starts with.
STARTING_CREDITS=3
# Credits deducted per job (auto-refunded if the job fails/is cancelled).
CREDITS_PER_JOB=1

# ── Logging ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=bot.log
